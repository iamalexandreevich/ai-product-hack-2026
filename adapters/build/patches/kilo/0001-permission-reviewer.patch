From 2565b968383ce024429947bdbd24d148c1ca67f1 Mon Sep 17 00:00:00 2001
From: AgentGate <gate@agentgate.dev>
Date: Fri, 4 Sep 2026 11:35:44 +0300
Subject: [PATCH] gate: revive permission.ask hook via a permission reviewer

Kilo variant of the opencode patch. Kilo rewrote packages/opencode/src/permission
(557 lines vs upstream 223: ConfigProtection, KiloHeadless, drain, session-scoped
rules), so the upstream patch does not apply. Anchors differ: ask returns AskOutcome,
the auto-approve early return carries the deciding rule, and Service.of exposes three
extra Kilo methods. Reviewer lives in the layer closure, not InstanceState.
---
 packages/opencode/src/permission/index.ts | 40 ++++++++++++++++++++++-
 packages/opencode/src/plugin/index.ts     | 12 ++++++-
 2 files changed, 50 insertions(+), 2 deletions(-)

diff --git a/packages/opencode/src/permission/index.ts b/packages/opencode/src/permission/index.ts
index a4a5b8a..6f53fbe 100644
--- a/packages/opencode/src/permission/index.ts
+++ b/packages/opencode/src/permission/index.ts
@@ -72,10 +72,19 @@ export interface AskOutcome {
 }
 // kilocode_change end
 
+// gate_change start: a reviewer sees the effective rule decision and may replace
+// it, giving Kilo the same interception point opencode 2.0 has via permission.hook.
+export type GateReviewer = (
+  input: Request,
+  output: { status: "allow" | "ask" | "deny"; message?: string },
+) => Effect.Effect<void>
+// gate_change end
+
 export interface Interface {
   readonly ask: (input: AskInput) => Effect.Effect<AskOutcome, Error> // kilocode_change - was Effect<void>; returns the decision
   readonly reply: (input: ReplyInput) => Effect.Effect<void, NotFoundError>
   readonly list: () => Effect.Effect<ReadonlyArray<Request>>
+  readonly setReviewer: (fn: GateReviewer) => Effect.Effect<void> // gate_change
   // kilocode_change start
   readonly saveAlwaysRules: (input: z.infer<typeof SaveAlwaysRulesInput>) => Effect.Effect<void, NotFoundError>
   readonly allowEverything: (input: z.infer<typeof AllowEverythingInput>) => Effect.Effect<void>
@@ -160,6 +169,7 @@ const layer = Layer.effect(
   Service,
   Effect.gen(function* () {
     const events = yield* EventV2Bridge.Service
+    let reviewer: GateReviewer | undefined // gate_change: closure-scoped, shared
     const config = yield* Config.Service // kilocode_change
     const database = yield* Database.Service // kilocode_change
     const state = yield* InstanceState.make<State>(
@@ -241,6 +251,33 @@ const layer = Layer.effect(
         needsAsk = true
       }
 
+      // gate_change start: reviewer may replace the effective decision.
+      if (reviewer) {
+        const gate = {
+          status: (needsAsk ? "ask" : "allow") as "allow" | "ask" | "deny",
+          message: undefined as string | undefined,
+        }
+        const info: Request = {
+          id: request.id ?? PermissionV1.ID.ascending(),
+          sessionID: request.sessionID,
+          permission: request.permission,
+          patterns: request.patterns,
+          metadata: request.metadata,
+          always: request.always,
+          tool: request.tool,
+        }
+        yield* reviewer(info, gate)
+        if (gate.status === "deny") {
+          return yield* new DeniedError({
+            ruleset: [
+              { permission: request.permission, pattern: request.patterns[0] ?? "*", action: "deny" } as Rule,
+            ],
+          })
+        }
+        needsAsk = gate.status === "ask"
+      }
+      // gate_change end
+
       if (!needsAsk) return { manual: false, rule: approvedRule } // kilocode_change - report auto-approval
 
       // kilocode_change start - headless subagent asks fail instead of queuing for a reply that never comes (#11903)
@@ -463,7 +500,8 @@ const layer = Layer.effect(
     })
     // kilocode_change end
 
-    return Service.of({ ask, reply, list, saveAlwaysRules, allowEverything, pending }) // kilocode_change
+    const setReviewer = (fn: GateReviewer) => Effect.sync(() => { reviewer = fn }) // gate_change
+    return Service.of({ ask, reply, list, saveAlwaysRules, allowEverything, pending, setReviewer }) // kilocode_change
   }),
 )
 
diff --git a/packages/opencode/src/plugin/index.ts b/packages/opencode/src/plugin/index.ts
index df73e82..f860494 100644
--- a/packages/opencode/src/plugin/index.ts
+++ b/packages/opencode/src/plugin/index.ts
@@ -34,6 +34,7 @@ import { registerAdapter } from "@/control-plane/adapters"
 import type { WorkspaceAdapter } from "@/control-plane/types"
 import { RuntimeFlags } from "@/effect/runtime-flags"
 import { EventV2Bridge } from "@/event-v2-bridge"
+import { Permission } from "../permission" // gate_change
 import { InstallationChannel } from "@opencode-ai/core/installation/version"
 
 type State = {
@@ -313,6 +314,15 @@ const layer = Layer.effect(
       yield* InstanceState.get(state)
     })
 
+    // gate_change: revive the (dead) permission.ask hook by registering a reviewer
+    // that runs the plugin hooks. The reviewer is invoked from inside the permission
+    // service's ask flow, which already carries the instance context, so the hook
+    // trigger runs directly — trigger mutates `output` in place, asVoid drops its return.
+    const permission = yield* Permission.Service
+    yield* permission.setReviewer((input, output) =>
+      trigger("permission.ask", input as any, output as any).pipe(Effect.asVoid),
+    )
+
     return Service.of({ trigger, list, init })
   }),
 )
@@ -320,7 +330,7 @@ const layer = Layer.effect(
 export const node = LayerNode.make({
   service: Service,
   layer: layer,
-  deps: [EventV2Bridge.node, Config.node, RuntimeFlags.node],
+  deps: [EventV2Bridge.node, Config.node, RuntimeFlags.node, Permission.node], // gate_change
 })
 
 export * as Plugin from "."
