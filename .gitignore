# Secrets. service/.env holds live VDS credentials and provider keys.
.env
.env.*

# Agent working directories.
.claude
.superpowers

# Python byte code and tool caches.
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# Virtualenvs.
.venv/
venv/

# --- adapters (направление 1) ---
node_modules/

# машинно-зависимый: build/build.sh пишет туда локальные пути и sha свежего билда
adapters/build/manifest.json

# вендоренная копия @agentgate/gate-core внутри Codex-плагина;
# генерируется packages/plugin-codex/sync-core.sh, не должна разъезжаться с packages/core/src
adapters/packages/plugin-codex/marketplace/plugins/gate/vendor/

# бэкапы, которые делает инсталлер
*.bak

# macOS. Finder writes .DS_Store into any directory it opens, including ones
# nobody edited, so these appear on their own and get committed by accident.
.DS_Store
._*
.Spotlight-V100
.Trashes
.fseventsd

# Windows.
Thumbs.db
Desktop.ini

# Editors.
.idea/
.vscode/
*.swp
*~
