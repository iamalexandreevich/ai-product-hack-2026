# Скопируйте в .env и заполните. Загрузка: PowerShell — . .\tools\load-env.ps1
#                                          Bash       — set -a; . ./.env; set +a

# Сервис AgentGate под тестом. Токен: AGENTGATE_TOKEN или ключ agk_...
SECURITY_SERVICE_URL=https://api.openmagi.ru
SECURITY_SERVICE_TOKEN=

# Только для --adapter claude-code. Заполните РОВНО ОДНУ из двух:
# обе сразу — ошибка, приоритета между ними нет.

# claude setup-token -> sk-ant-oat01-...
# По подписке Claude, API-кредиты не тратятся.
CLAUDE_CODE_OAUTH_TOKEN=

# console.anthropic.com -> API keys -> Create key, привязать к workspace -> sk-ant-api03-...
# Ключ без workspace отвергается с HTTP 400.
ANTHROPIC_API_KEY=
